# Backend environment variables
# Copy this file to .env and fill in your values

# Secret key for signing JWT tokens (use a long random string)
SECRET_KEY=change-me-to-a-long-random-secret-key

# AI Provider: "openai", "gemini", or "openrouter"
AI_PROVIDER=openai

# Use AI generation (true) or local offline template generator (false)
# If true with no/expired API key, it automatically falls back to local.
USE_AI=true

# OpenAI API Key (for provider=openai)
OPENAI_API_KEY=sk-your-openai-key

# Gemini API Key (for provider=gemini)
GEMINI_API_KEY=your-gemini-key

# OpenRouter API Key (for provider=openrouter, starts with sk-or-v1-)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# Optional: model names
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_MODEL=openai/gpt-4o-mini

# Demo account (auto-created on startup)
DEMO_USERNAME=demo
